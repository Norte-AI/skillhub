# Development database only. Use dedicated credentials for deployments.
SKILLHUB_DATABASE_URL=postgres://skillhub:skillhub-local-development@127.0.0.1:55432/skillhub
SKILLHUB_TEST_DATABASE_URL=postgres://skillhub:skillhub-local-development@127.0.0.1:55432/skillhub
SKILLHUB_HOST=127.0.0.1
PORT=4317
# Setting this disables anonymous loopback administration.
# SKILLHUB_TOKEN=replace-with-a-local-admin-token

# Sign newly built releases with an Ed25519 private key.
# SKILLHUB_SIGNING_KEY_FILE=.skillhub-keys/private.pem

SKILLHUB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Explicitly allow anonymous read-only Git clones through a Docker bridge/proxy.
# SKILLHUB_GIT_ALLOW_REMOTE=1

# Optional separated staff roles; configuring any disables anonymous admin.
# SKILLHUB_EDITOR_TOKEN=unique-editor-token
# SKILLHUB_REVIEWER_TOKEN=unique-reviewer-token
# SKILLHUB_PUBLISHER_TOKEN=unique-publisher-token
