{
  "proxyOverride": "Child process only; no global changes",
  "commands": [
    {
      "args": [
        "plugin",
        "marketplace",
        "add",
        "http://127.0.0.1:4317/git/codex.git",
        "--ref",
        "main",
        "--json"
      ],
      "exit": 0,
      "stdout": "{\n  \"marketplaceName\": \"skill-hub\",\n  \"installedRoot\": \"/private<temporary-CODEX_HOME>/.tmp/marketplaces/skill-hub\",\n  \"alreadyAdded\": false\n}\n",
      "stderr": ""
    },
    {
      "args": [
        "plugin",
        "marketplace",
        "list",
        "--json"
      ],
      "exit": 0,
      "stdout": "{\n  \"marketplaces\": [\n    {\n      \"name\": \"skill-hub\",\n      \"root\": \"/private<temporary-CODEX_HOME>/.tmp/marketplaces/skill-hub\",\n      \"marketplaceSource\": {\n        \"sourceType\": \"git\",\n        \"source\": \"http://127.0.0.1:4317/git/codex.git\"\n      }\n    }\n  ]\n}\n",
      "stderr": ""
    },
    {
      "args": [
        "plugin",
        "list",
        "--marketplace",
        "skill-hub",
        "--available",
        "--json"
      ],
      "exit": 0,
      "stdout": "{\n  \"installed\": [],\n  \"available\": [\n    {\n      \"pluginId\": \"personal@skill-hub\",\n      \"name\": \"personal\",\n      \"marketplaceName\": \"skill-hub\",\n      \"version\": \"1.0.0\",\n      \"installed\": false,\n      \"enabled\": false,\n      \"source\": {\n        \"source\": \"local\",\n        \"path\": \"/private<temporary-CODEX_HOME>/.tmp/marketplaces/skill-hub/plugins/personal\"\n      },\n      \"marketplaceSource\": {\n        \"sourceType\": \"git\",\n        \"source\": \"http://127.0.0.1:4317/git/codex.git\"\n      },\n      \"installPolicy\": \"AVAILABLE\",\n      \"authPolicy\": \"ON_INSTALL\"\n    }\n  ]\n}\n",
      "stderr": ""
    }
  ],
  "files": {
    ".tmp/marketplaces/skill-hub/.agents/plugins/marketplace.json": {
      "name": "skill-hub",
      "interface": {
        "displayName": "Skill Hub"
      },
      "plugins": [
        {
          "name": "personal",
          "source": {
            "source": "local",
