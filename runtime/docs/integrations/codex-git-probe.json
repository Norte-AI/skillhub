          "policy": {
            "installation": "AVAILABLE",
            "authentication": "ON_INSTALL"
          },
          "category": "Productivity"
        }
      ]
    },
    ".tmp/marketplaces/skill-hub/plugins/personal/.codex-plugin/plugin.json": {
      "name": "personal",
      "version": "1.0.0",
      "description": "用于本地验证的示例规则包，尚未验证真实客户端注入。",
      "skills": "./skills/"
